<Window x:Class="SForce.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SFORCE" Width="1040" Height="760" MinWidth="860" MinHeight="640"
        Background="{StaticResource PageBrush}" WindowStyle="None"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" FontFamily="SF Pro, SF Arabic" FontWeight="Medium">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="7" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
      <RowDefinition Height="68" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0E1014" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <Button Content="✕" Width="34" Height="34" Margin="0,0,7,0" FontSize="13"
                  Style="{StaticResource SecondaryButton}" Padding="0" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Content="—" Width="34" Height="34" FontSize="13"
                  Style="{StaticResource SecondaryButton}" Padding="0" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
            <TextBlock Text="SF" Foreground="#11140E" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="SFORCE" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="  /  SF Pro Everywhere" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="34,28,34,24" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="فونت‌های هدف" FontSize="21" FontWeight="Bold" />
                  <TextBlock Text="فایل‌های رسمی SF Pro و SF Arabic خودت را انتخاب کن." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="افزودن فونت‌ها" Style="{StaticResource SecondaryButton}" Click="ImportFonts_Click" />
              </Grid>

              <TextBlock Text="لاتین و رابط ویندوز" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7" />
              <ComboBox x:Name="LatinFamilyCombo" SelectionChanged="FontSelection_Changed" />

              <TextBlock Text="فارسی، عربی، اردو و پشتو" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,17,0,7" />
              <ComboBox x:Name="ArabicFamilyCombo" SelectionChanged="FontSelection_Changed" />

              <Border Background="#0D0F12" CornerRadius="13" Padding="18" Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock x:Name="PreviewLatin" Text="The quick brown fox — SFORCE" FontSize="27" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                  <TextBlock x:Name="PreviewArabic" Text="فارسی را باید زیبا و درست دید؛ دقیقاً همین‌قدر تمیز." FontSize="24" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="شدت اعمال" FontSize="21" FontWeight="Bold" />
              <CheckBox x:Name="AggressiveCheck" IsChecked="True" Margin="0,17,0,0">
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Force تهاجمی" FontWeight="SemiBold" />
                  <TextBlock Text="همهٔ اپ‌های عادی + Inter، Roboto، Arial، Helvetica و Tahoma به SF Pro نگاشت شوند." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>
              <TextBlock Text="وزن پایهٔ رابط" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18,0,7" />
              <ComboBox x:Name="WeightCombo" SelectedIndex="1">
                <ComboBoxItem Content="Regular — 400" Tag="400" />
                <ComboBoxItem Content="Medium — 500 (پیشنهادی)" Tag="500" />
                <ComboBoxItem Content="Semibold — 600" Tag="600" />
              </ComboBox>
              <CheckBox x:Name="DeepForceCheck" IsChecked="True" Margin="0,18,0,0">
                <StackPanel Margin="8,0,0,0">
                  <TextBlock Text="Deep Force — تزریق واقعی" FontWeight="SemiBold" />
                  <TextBlock Text="DirectWrite و GDI در Explorer، تنظیمات، Notion، Claude، ChatGPT و مرورگرها patch شوند." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>
              <TextBlock Text="ممکن است ظاهر بعضی سندها یا سایت‌های طراحی‌شده با فونت خاص عوض شود؛ هر زمان بخواهی Restore همه‌چیز را برمی‌گرداند."
                         TextWrapping="Wrap" Foreground="#C8A96A" FontSize="12" Margin="0,14,0,0" />
            </StackPanel>
          </Border>

        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="وضعیت سیستم" FontSize="21" FontWeight="Bold" />
                  <TextBlock x:Name="StatusText" Text="در حال بررسی…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="StatusPill" Grid.Column="1" CornerRadius="13" Background="#282C34" Padding="12,7" VerticalAlignment="Top">
                  <TextBlock x:Name="StatusPillText" Text="CHECK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                </Border>
              </Grid>
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="دسترسی مدیر سیستم" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="AdminStatus" Grid.Column="1" Text="فعال" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="بکاپ بازگشت" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="BackupStatus" Grid.Column="1" Text="—" FontWeight="SemiBold" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Deep Force" Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="DeepForceStatus" Grid.Column="1" Text="—" FontWeight="SemiBold" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="مرورگر و وب‌اپ‌ها" FontSize="21" FontWeight="Bold" />
              <TextBlock Text="Force Pack فونت را با !important داخل همهٔ سایت‌ها، PWAها، Notion Web، ChatGPT و Claude اعمال می‌کند؛ آیکن‌ها و کدها سالم می‌مانند."
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,17" />
              <Button x:Name="BrowserButton" Content="ساخت / به‌روزرسانی Force Pack" Style="{StaticResource SecondaryButton}" Click="BuildBrowserPack_Click" />
              <Button x:Name="OpenExtensionButton" Content="باز کردن پوشهٔ افزونه" Style="{StaticResource SecondaryButton}" Margin="0,9,0,0" Click="OpenExtension_Click" IsEnabled="False" />
              <TextBlock x:Name="BrowserHint" Text="برای Chrome، Edge، Brave و Arc؛ یک بار Load unpacked لازم است." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Background="#121A10" BorderBrush="#29411D">
            <StackPanel>
              <TextBlock Text="بعد از Apply" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="بعد از Deep Force اپ‌های باز هدف خودکار دوباره inject می‌شوند؛ اگر موردی cache داشت، همان اپ را فقط یک‌بار ببند و باز کن."
                         TextWrapping="Wrap" Foreground="#B8C8AF" Margin="0,8,0,0" LineHeight="20" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#0E1014">
      <Grid Margin="22,10" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="v2.0  •  reversible deep force" Foreground="#565C67" VerticalAlignment="Center" FlowDirection="LeftToRight" />
        <TextBlock Grid.Column="1" x:Name="FooterText" Text="SFORCE آماده است." Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center" FlowDirection="RightToLeft" TextTrimming="CharacterEllipsis" Margin="18,0" />
        <Button x:Name="RestoreButton" Grid.Column="2" Content="بازگردانی کامل" Style="{StaticResource DangerButton}" Click="Restore_Click" Padding="18,10" />
        <Button x:Name="ApplyButton" Grid.Column="4" Content="اعمال + Deep Force" Style="{StaticResource PrimaryButton}" FontSize="14" Click="Apply_Click" Padding="24,10" />
      </Grid>
    </Border>
  </Grid>
</Window>
